{
  "id": "commentary",
  "canvas": { "width": 1080, "height": 1920 },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "style": {
        "position": { "mode": "absolute", "x": 0, "y": 0, "width": "100%", "height": "100%" },
        "color": "#0D0D12",
        "zIndex": 0
      }
    },
    {
      "id": "video",
      "type": "video",
      "binding": "{{video.path}}",
      "style": {
        "position": { "mode": "relative", "region": "top", "heightFraction": 0.52 },
        "fit": "contain",
        "zIndex": 10
      }
    },
    {
      "id": "caption-divider",
      "type": "rectangle",
      "style": {
        "position": { "mode": "relative", "region": "middle", "heightFraction": 0.01 },
        "color": "#FFE135",
        "zIndex": 15
      }
    },
    {
      "id": "caption",
      "type": "subtitle",
      "binding": "{{subtitle.ass}}",
      "style": {
        "position": { "mode": "relative", "region": "middle", "heightFraction": 0.26 },
        "align": "center",
        "verticalAlign": "center",
        "font": "Arial",
        "fontSize": 58,
        "color": "#FFFFFF",
        "outlineColor": "#000000",
        "outlineWidth": 4,
        "shadowColor": "#000000",
        "shadowDepth": 2,
        "zIndex": 20
      }
    },
    {
      "id": "commentary-label",
      "type": "text",
      "text": "ANALISIS",
      "style": {
        "position": { "mode": "relative", "region": "bottom", "heightFraction": 0.04 },
        "align": "left",
        "verticalAlign": "center",
        "font": "Arial",
        "fontSize": 22,
        "color": "#FFE135",
        "zIndex": 25
      }
    },
    {
      "id": "commentary-text",
      "type": "text",
      "binding": "{{commentary.text}}",
      "style": {
        "position": { "mode": "relative", "region": "bottom", "heightFraction": 0.20 },
        "align": "left",
        "verticalAlign": "top",
        "padding": 16,
        "font": "Arial",
        "fontSize": 38,
        "color": "#E5E7EB",
        "backgroundColor": "#1A1A2E",
        "backgroundFit": "block",
        "zIndex": 26
      }
    },
    {
      "id": "channel-name",
      "type": "text",
      "binding": "{{channel.name}}",
      "optional": true,
      "style": {
        "position": { "mode": "absolute", "x": "2%", "y": "88%", "width": "40%", "height": "8%" },
        "align": "left",
        "verticalAlign": "center",
        "font": "Arial",
        "fontSize": 24,
        "color": "#9CA3AF",
        "zIndex": 30
      }
    }
  ]
}
