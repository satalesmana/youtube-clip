# --- AI agent routing ---
# "ollama" (local/self-hosted Ollama server) or "router" (OpenAI-compatible
# AI router, e.g. 9Router) — selects which provider handles highlight analysis.
AI_PROVIDER=ollama

# --- Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_MS=120000
OLLAMA_MAX_RETRIES=3

# --- AI router (only required when AI_PROVIDER=router) ---
ROUTER_BASE_URL=http://127.0.0.1:20128
ROUTER_API_KEY="sk-71f2bfbc773ae094-xcdo51-eebbb67e"
ROUTER_MODEL=auto
ROUTER_TEMPERATURE=0.2
ROUTER_TIMEOUT_MS=120000
ROUTER_MAX_RETRIES=3

# --- Whisper ---
# "whisperx" (recommended: forced alignment for accurate word timestamps),
# "faster-whisper" (GPU-accelerated), or "whisper-cpp" (CPU-only fallback)
WHISPER_PROVIDER=whisperx
WHISPER_BINARY_PATH=whisperx
# Model size vs accuracy/speed tradeoff:
#   tiny  = 39M params, fastest, lowest accuracy
#   base  = 74M params, fast, basic accuracy
#   small = 244M params, balanced
#   medium = 769M params, good accuracy (recommended for 8GB RAM)
#   large-v3 = 1550M params, best accuracy (needs 16GB+ RAM)
WHISPER_MODEL=medium
# Set explicit language for ~15% better accuracy vs "auto".
# Use "en" for English, "id" for Indonesian, etc.
WHISPER_LANGUAGE=id
# Extra CLI args passed through to the whisper binary.
# Format: --device <cpu|cuda|mps> --compute_type <float32|float16|int8>
WHISPER_EXTRA_ARGS=--device cpu --compute_type float32

# --- yt-dlp ---
YT_DLP_BINARY_PATH=yt-dlp
YT_DLP_MAX_RETRIES=3
# If yt-dlp fails with "Sign in to confirm you're not a bot", set this to
# pass cookies, e.g. YT_DLP_EXTRA_ARGS=--cookies-from-browser chrome
YT_DLP_EXTRA_ARGS=

# --- FFmpeg ---
# Must be a libass-enabled build (needed for the `ass`/`subtitles` filter used
# to burn captions). Homebrew's plain "ffmpeg" formula does NOT include
# libass — use `brew install ffmpeg-full` and point this at its binary
# (e.g. /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg) if subtitle burning fails.
FFMPEG_BINARY_PATH=ffmpeg

# --- Storage paths (relative to project root) ---
# Each processed video gets an isolated workspace: outputs/{videoId}/...
OUTPUTS_DIR=outputs

# --- Chunking ---
CHUNK_MAX_TOKENS=2500
CHUNK_OVERLAP_SECONDS=18

# --- Highlight selection ---
HIGHLIGHT_MIN_SECONDS=20
HIGHLIGHT_MAX_SECONDS=60
HIGHLIGHT_TOP_N=10

# --- Clip generation (hard safety bounds + concurrency for the renderer) ---
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=90
CLIP_MAX_CONCURRENCY=2
CLIP_DURATION_TOLERANCE_SECONDS=2
CLIP_MAX_RETRIES=2

# --- Clip refinement (natural speech-boundary snapping) ---
REFINEMENT_LEAD_IN_SECONDS=2.5
REFINEMENT_TRAILING_SECONDS=1.5
REFINEMENT_MIN_SECONDS=20
REFINEMENT_MAX_SECONDS=60

# --- Subtitle grouping ---
SUBTITLE_MAX_WORDS_PER_EVENT=4
SUBTITLE_PAUSE_BREAK_SECONDS=0.5

# --- ASS caption style ---
# Hex colors must be quoted — otherwise dotenv treats the leading `#` as a
# comment and the value ends up empty.
ASS_FONT_NAME=Arial
ASS_FONT_SIZE=90
ASS_BASE_COLOR="#FFFFFF"
ASS_HIGHLIGHT_COLOR="#FFE135"
ASS_KEYWORD_COLOR="#FF3B30"
ASS_OUTLINE_COLOR="#000000"
ASS_SHADOW_COLOR="#000000"
ASS_OUTLINE_WIDTH=4
ASS_SHADOW_DEPTH=2
ASS_VERTICAL_POSITION_FRACTION=0.75
# none | karaoke | pop | fade | slide
ASS_ANIMATION_STYLE=karaoke

# --- Thumbnail ---
THUMBNAIL_CANDIDATE_COUNT=5

# --- Rendering output ---
RENDER_OUTPUT_WIDTH=1080
RENDER_OUTPUT_HEIGHT=1920
RENDER_FRAME_RATE=30
RENDER_PRESET=medium
RENDER_CRF=18
RENDER_AUDIO_BITRATE_KBPS=192

# --- Research pipeline (`POST /api/research`) ---
# Finds viral topics from news/social signals, then matches YouTube videos.
#
# YouTube Data API v3 key (https://console.cloud.google.com/apis/library/youtube.googleapis.com).
# Primary source for video search. When empty, falls back to `yt-dlp ytsearch`.
YOUTUBE_API_KEY=
YOUTUBE_SEARCH_MAX_RESULTS=5
# Timeout per YouTube search request in milliseconds.
YOUTUBE_SEARCH_TIMEOUT_MS=15000

# News RSS feeds, comma-separated. Optional `[label]` prefix + `:lang=xx` suffix
# per feed, e.g. [cnn-indonesia]https://www.cnnindonesia.com/rss:lang=id
RESEARCH_RSS_FEEDS=https://www.cnnindonesia.com/rss,https://feeds.bbci.co.uk/news/rss.xml,https://www.kompas.com/feed,https://rss.detik.com
RESEARCH_RSS_MAX_ITEMS_PER_FEED=15
RESEARCH_RSS_TIMEOUT_MS=10000

# Subreddits for hot posts, comma-separated (falls back to r/popular when empty).
RESEARCH_REDDIT_SUBREDDITS=worldnews,indonesia,technology
RESEARCH_REDDIT_MAX_POSTS_PER_SUBREDDIT=10
RESEARCH_REDDIT_TIMEOUT_MS=10000

# Google News RSS (trending headlines, no API key). Topic feeds are available
# per country, e.g. `topic/NATION` for Indonesia:
# https://news.google.com/rss/headlines/section/topic/NATION?hl=id&gl=ID&ceid=ID:id
RESEARCH_TRENDS_FEED_URL=https://news.google.com/rss/headlines/section/topic/NATION?hl=id&gl=ID&ceid=ID:id
RESEARCH_TRENDS_MAX_QUERIES=20
RESEARCH_TRENDS_TIMEOUT_MS=10000

# X/Twitter via the `xurl` CLI (must be authenticated with `xurl auth oauth2`
# first — see https://github.com/xdevplatform/xurl). Empty query disables X.
RESEARCH_X_SEARCH_QUERY=
RESEARCH_X_MAX_POSTS=10

# Pipeline controls.
RESEARCH_MAX_TRENDS=10
# Max signals sent to the LLM (keeps prompt size manageable for local models).
RESEARCH_MAX_SIGNALS_FOR_LLM=80
# Language for topic titles/summaries: auto | en | id | ... (any LLM-supported tag).
RESEARCH_LANGUAGE=auto

# Research LLM (OpenAI-compatible). When BASE_URL is empty, the main AI
# backend is used instead (router → local Ollama, both via /v1/chat/completions).
RESEARCH_LLM_BASE_URL=
RESEARCH_LLM_API_KEY=
RESEARCH_LLM_MODEL=qwen3:14b
RESEARCH_LLM_TEMPERATURE=0.2
RESEARCH_LLM_TIMEOUT_MS=120000
RESEARCH_LLM_MAX_RETRIES=2

# --- Logging ---
LOG_LEVEL=info

# --- Server ---
PORT=3000
HOST=0.0.0.0
