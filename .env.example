# --- AI Viral Content Transformer: TTS ---
# edge-tts (default, free, local CLI) | openai (OpenAI-compatible)
TTS_PROVIDER=edge-tts
# Voice name: see `edge-tts --list-voices`
TTS_VOICE=id-ID-ArdiNeural
TTS_RATE=+0%
# Path to edge-tts binary (optional if in PATH)
# Use .venv/bin/edge-tts for project-local installation
TTS_BINARY_PATH=.venv/bin/edge-tts
# OpenAI-compatible TTS settings
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1

# --- Speech-to-text: OpenAI STT (optional) ---
# WHISPER_PROVIDER=openai (or pick "openai" as STT engine per request in the UI)
# Falls back to TTS_BASE_URL / TTS_API_KEY when left empty, so a single
# gateway serving /audio/transcriptions + /audio/speech works out of the box.
OPENAI_WHISPER_BASE_URL=
OPENAI_WHISPER_API_KEY=
OPENAI_WHISPER_MODEL=gpt-4o-transcribe
