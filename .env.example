# --- AI agent routing ---
# "ollama" (local/self-hosted Ollama server) or "router" (OpenAI-compatible
# AI router, e.g. 9Router) — selects which provider handles highlight analysis.
AI_PROVIDER=ollama

# --- Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_MS=120000
OLLAMA_MAX_RETRIES=3

# --- AI router (only required when AI_PROVIDER=router) ---
ROUTER_BASE_URL=http://10.9.14.126:20128
ROUTER_API_KEY=
ROUTER_MODEL=FreeModel
ROUTER_TEMPERATURE=0.2
ROUTER_TIMEOUT_MS=120000
ROUTER_MAX_RETRIES=3

# --- Whisper ---
# "faster-whisper" (preferred) or "whisper-cpp" (fallback)
WHISPER_PROVIDER=faster-whisper
WHISPER_BINARY_PATH=whisper
WHISPER_MODEL=base
WHISPER_LANGUAGE=auto

# --- yt-dlp ---
YT_DLP_BINARY_PATH=yt-dlp
YT_DLP_MAX_RETRIES=3
# If yt-dlp fails with "Sign in to confirm you're not a bot", set this to
# pass cookies, e.g. YT_DLP_EXTRA_ARGS=--cookies-from-browser chrome
YT_DLP_EXTRA_ARGS=

# --- FFmpeg ---
# Must be a libass-enabled build (needed for the `ass`/`subtitles` filter used
# to burn captions). Homebrew's plain "ffmpeg" formula does NOT include
# libass — use `brew install ffmpeg-full` and point this at its binary
# (e.g. /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg) if subtitle burning fails.
FFMPEG_BINARY_PATH=ffmpeg

# --- Storage paths (relative to project root) ---
DOWNLOADS_DIR=downloads
TRANSCRIPTS_DIR=transcripts
OUTPUTS_DIR=outputs
TEMP_DIR=temp

# --- Chunking ---
CHUNK_MAX_TOKENS=2500
CHUNK_OVERLAP_SECONDS=18

# --- Highlight selection ---
HIGHLIGHT_MIN_SECONDS=20
HIGHLIGHT_MAX_SECONDS=60
HIGHLIGHT_TOP_N=10

# --- Clip generation (hard safety bounds + concurrency for the renderer) ---
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=90
CLIP_MAX_CONCURRENCY=2
CLIP_DURATION_TOLERANCE_SECONDS=2
CLIP_MAX_RETRIES=2

# --- Clip refinement (natural speech-boundary snapping) ---
REFINEMENT_LEAD_IN_SECONDS=2.5
REFINEMENT_TRAILING_SECONDS=1.5
REFINEMENT_MIN_SECONDS=20
REFINEMENT_MAX_SECONDS=60

# --- Subtitle grouping ---
SUBTITLE_MAX_WORDS_PER_EVENT=4
SUBTITLE_PAUSE_BREAK_SECONDS=0.5

# --- ASS caption style ---
# Hex colors must be quoted — otherwise dotenv treats the leading `#` as a
# comment and the value ends up empty.
ASS_FONT_NAME=Arial
ASS_FONT_SIZE=90
ASS_BASE_COLOR="#FFFFFF"
ASS_HIGHLIGHT_COLOR="#FFE135"
ASS_KEYWORD_COLOR="#FF3B30"
ASS_OUTLINE_COLOR="#000000"
ASS_SHADOW_COLOR="#000000"
ASS_OUTLINE_WIDTH=4
ASS_SHADOW_DEPTH=2
ASS_VERTICAL_POSITION_FRACTION=0.75
# none | karaoke | pop | fade | slide
ASS_ANIMATION_STYLE=karaoke

# --- Thumbnail ---
THUMBNAIL_CANDIDATE_COUNT=5

# --- Rendering output ---
RENDER_OUTPUT_WIDTH=1080
RENDER_OUTPUT_HEIGHT=1920
RENDER_FRAME_RATE=30
RENDER_PRESET=medium
RENDER_CRF=18
RENDER_AUDIO_BITRATE_KBPS=192

# --- Logging ---
LOG_LEVEL=info

# --- Server ---
PORT=3000
HOST=0.0.0.0
