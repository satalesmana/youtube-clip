# --- AI router (OpenAI-compatible, e.g. 9Router / OpenRouter) ---
AI_PROVIDER=router
ROUTER_BASE_URL=https://api.openai.com
ROUTER_API_KEY=your_api_key_here
ROUTER_MODEL=gpt-4o-mini
ROUTER_TEMPERATURE=0.2
ROUTER_TIMEOUT_MS=120000
ROUTER_MAX_RETRIES=3

# --- AI Viral Content Transformer: TTS ---
# edge-tts (default, free, local CLI) | openai (OpenAI-compatible, via 9Router)
# | fish-audio (direct api.fish.audio, full params: temperature, top_p, prosody)
TTS_PROVIDER=edge-tts
# Voice name: see `edge-tts --list-voices`
TTS_VOICE=id-ID-ArdiNeural
TTS_RATE=+0%
# Path to edge-tts binary (optional if in PATH)
# Use .venv/bin/edge-tts for project-local installation
TTS_BINARY_PATH=.venv/bin/edge-tts
# OpenAI-compatible TTS settings
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1

# Fish Audio direct TTS settings (TTS_PROVIDER=fish-audio)
# Get API key at https://fish.audio/app/api-keys/
TTS_FISH_BASE_URL=
TTS_FISH_API_KEY=
TTS_FISH_MODEL=s2.1-pro-free
# mp3 | wav | opus | pcm16
TTS_FISH_FORMAT=
# Expressiveness 0-1 (default 0.7)
TTS_FISH_TEMPERATURE=
# Diversity 0-1 (default 0.7)
TTS_FISH_TOP_P=
# Prosody speed multiplier (default 1; TTS_RATE "+10%" -> 1.1)
TTS_FISH_SPEED=
# Prosody volume offset (default 0)
TTS_FISH_VOLUME=
# Sample rate Hz (default 44100)
TTS_FISH_SAMPLE_RATE=
# Latency/quality: normal | balanced | low
TTS_FISH_LATENCY=

# --- Speech-to-text: OpenAI STT (optional) ---
# WHISPER_PROVIDER=openai (or pick "openai" as STT engine per request in the UI)
# Falls back to TTS_BASE_URL / TTS_API_KEY when left empty, so a single
# gateway serving /audio/transcriptions + /audio/speech works out of the box.
OPENAI_WHISPER_BASE_URL=
OPENAI_WHISPER_API_KEY=
OPENAI_WHISPER_MODEL=gpt-4o-transcribe
